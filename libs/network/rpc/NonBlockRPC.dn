uses libs.utils.Constants

component provides libs.network.rpc.NonBlockRPC requires libs.network.rpc.RPCUtil rpcUtil {
    Response acc[] = new Response[]()

    Response[] NonBlockRPC:nonBlockingBroadcastList(Request r, int remoteComponents) {
        Thread threads[] = new Thread[]()
        
        for(int i = 0; i < remoteComponents; i++) {
            Thread t = asynch::makeNonBlockingRequest(r, i)
            threads = new Thread[](threads, t)
        }

        for(int i = 0; i < threads.arrayLength; i++) {
            threads[i].join()
        }

        return acc
    }

    void makeNonBlockingRequest(Request r, int poolPosition) {
        acc = new Response[](acc, rpcUtil.make(r, poolPosition))
    }
}