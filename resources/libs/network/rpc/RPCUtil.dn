uses net.TCPSocket
uses libs.network.RemotesHandler

data Address {
    char name[]
    int port
}

data Metadata {
    char name[]
    char value[]
}

data TransactionData {
    char name[]
    char value[]
}

data Request {
    Metadata meta[]
    char content[]
}

data Response {
    Metadata meta[]
    char content[]
}

data Pool {
    TCPSocket sockets[]
    Mutex locks[]
}

interface RPCUtil {
    void setPoolSize(int size)
    Response make(Request r, Pool p, int poolPosition)
    Request parseRequestFromString(char requestString[])
    bool sendData(TCPSocket s, char requestContent[])
    char[] receiveData(TCPSocket s)
    char[] buildRawResponse(Response r)
    Response buildResponse(char method[], char status[])
    Response buildResponseWithData(char method[], char status[], char content[])
    char[] getMethodFromMetadata(Metadata meta[])
}
