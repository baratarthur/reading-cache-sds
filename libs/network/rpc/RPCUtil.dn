uses libs.utils.Constants

const char debugMSG[] = "[@RPCUtil] - "

component provides libs.network.rpc.RPCUtil requires data.json.JSONEncoder je, net.TCPSocket,
    data.IntUtil iu, data.StringUtil su, time.Calendar ic, time.TimeUnix timeUnix, libs.krabs.LatencyStore ls,
    libs.utils.Logger logger, time.Timer timer {

    Response RPCUtil:make(ReqWrapper req) {
        TCPSocket socket = new TCPSocket()

        Response r = null
        char requestContent[] = null
        char responseContent[] = ""

        if (req.r.content != null) requestContent = new char[](je.jsonFromArray(req.r.meta), Constants.SEPARATOR, req.r.content)
        else requestContent = je.jsonFromArray(req.r.meta)

        DateTime timestampBeforeConnection = ic.getTime()
        if(!socket.connect(req.to.name, req.to.port)) {
            logger.error("Error: failed to connect to remote $(req.to.name):$(iu.makeString(req.to.port))")
            return null
        }
        
        sendData(socket, requestContent)

        responseContent = receiveData(socket)
        socket.disconnect()

        String rpcData[] = su.explode(responseContent, Constants.SEPARATOR)
        Metadata meta[] = je.jsonToArray(rpcData[0].string, typeof(Metadata[]))
        
        if(rpcData.arrayLength > 1) r = new Response(meta, rpcData[1].string)
        else r = new Response(meta)
        
        return r
    }

    bool RPCUtil:sendData(TCPSocket s, char requestContent[]) {
        int contentSize = dana.serial(requestContent).arrayLength
        char contentSizeStr[] = iu.makeString(contentSize)
        while(contentSizeStr.arrayLength < 8) contentSizeStr = new char[]("0", contentSizeStr)
        requestContent = new char[](contentSizeStr, requestContent)
        s.send(requestContent)
        return true
    }

    char[] RPCUtil:receiveData(TCPSocket s) {
        byte buff[] = s.recv(8)
        int messageSize = iu.intFromString(new char[](buff))
        char body[] = s.recv(messageSize)
        return su.rtrim(body)
    }

    Request RPCUtil:parseRequestFromString(char requestString[]) {
        Request r = null
        String json[] = su.explode(requestString, Constants.SEPARATOR)
        Metadata meta[] = je.jsonToArray(json[0].string, typeof(Metadata[]))

        if(json.arrayLength > 1) r = new Request(meta, json[1].string)
        else r = new Request(meta)

        return r
    }
    
    char[] RPCUtil:buildRawResponse(Response res) {
        char rawResponse[] = null
        
        if(res.content == null) rawResponse = new char[](je.jsonFromArray(res.meta))
        else rawResponse = new char[](je.jsonFromArray(res.meta), Constants.SEPARATOR, res.content)
        
        int responseSize = dana.serial(rawResponse).arrayLength
        char responseSizeStr[] = iu.makeString(responseSize)
        while(responseSizeStr.arrayLength < 8) responseSizeStr = new char[]("0", responseSizeStr)
        
        return new char[](responseSizeStr, rawResponse)
    }

    Response RPCUtil:buildResponse(char method[], char status[]) {
        Metadata statusMeta = new Metadata("status", status)
        Metadata methodMeta = new Metadata("method", method)
        Metadata allMetas[] = new Metadata[](statusMeta, methodMeta)
        return new Response(allMetas)
    }

    Response RPCUtil:buildResponseWithData(char method[], char status[], char content[]) {
        Metadata statusMeta = new Metadata("status", status)
        Metadata methodMeta = new Metadata("method", method)
        Metadata allMetas[] = new Metadata[](statusMeta, methodMeta)
        return new Response(allMetas, content)
    }

    char[] RPCUtil:getMethodFromMetadata(Metadata meta[]) {
        for(int i =0; i < meta.arrayLength; i++) {
            if(meta[i].name == "method") return meta[i].value
        }

        return ""
    }

}
