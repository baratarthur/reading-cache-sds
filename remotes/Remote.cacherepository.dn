uses libs.utils.Constants

const char debugMSG[] = "[@Remote]"


component provides remotes.Remote:cacherepository requires net.TCPSocket, net.TCPServerSocket, data.json.JSONEncoder je, time.Timer timer, libs.utils.PostsUtils pu, libs.krabs.LatencyStore ls, data.IntUtil iu, libs.utils.Logger logger, libs.network.rpc.RPCUtil connection, repositories.cache.CacheRepository remoteComponent {
	bool serviceStatus = false
	

	void Remote:start(int PORT) {
		TCPServerSocket host = new TCPServerSocket()
		serviceStatus = true
		

		if (!host.bind(TCPServerSocket.ANY_ADDRESS, PORT)) {
			logger.error("Error: failed to bind master socket")
			return
		}

		logger.info("$debugMSG - Server started on port $(iu.makeString(PORT))")
		while (serviceStatus) {
			TCPSocket client = new TCPSocket()
			if (client.accept(host)) asynch::handleRequest(client)
		}

	}

	void Remote:handleRequest(TCPSocket s) {
		char requestContent[] = connection.receiveData(s)
		if(requestContent == null) return
		Request req = connection.parseRequestFromString(requestContent)
		Response res = process(req)
		char rawResponse[] = connection.buildRawResponse(res)
		s.send(rawResponse)
	}

	Response process(Request req) {
		char method[] = connection.getMethodFromMetadata(req.meta)
		

		if(method == "setPosts") {
			SetPostsParamsFormat paramsData = je.jsonToData(req.content, typeof(SetPostsParamsFormat))
			remoteComponent.setPosts(paramsData.posts)
			return connection.buildResponse("setPosts", "200")
		}

		if(method == "addPostInCache") {
			AddPostInCacheParamsFormat paramsData = je.jsonToData(req.content, typeof(AddPostInCacheParamsFormat))
			remoteComponent.addPostInCache(paramsData.cachePost)
			return connection.buildResponse("addPostInCache", "200")
		}

		if(method == "addNewPostInCache") {
			AddNewPostInCacheParamsFormat paramsData = je.jsonToData(req.content, typeof(AddNewPostInCacheParamsFormat))
			remoteComponent.addNewPostInCache(paramsData.cachePost)
			return connection.buildResponse("addNewPostInCache", "200")
		}

		if(method == "storeNewPosts") {
			remoteComponent.storeNewPosts()
			return connection.buildResponse("storeNewPosts", "200")
		}

		if(method == "removeNewPostsFromCache") {
			remoteComponent.removeNewPostsFromCache()
			return connection.buildResponse("removeNewPostsFromCache", "200")
		}

		if(method == "getPostByIdFromCache") {
			GetPostByIdFromCacheParamsFormat paramsData = je.jsonToData(req.content, typeof(GetPostByIdFromCacheParamsFormat))
			CachedPost result = remoteComponent.getPostByIdFromCache(paramsData.postId)
			return connection.buildResponseWithData("getPostByIdFromCache", "200", je.jsonFromData(result))
		}

		if(method == "getCachedPosts") {
			Post result[] = remoteComponent.getCachedPosts()
			return connection.buildResponseWithData("getCachedPosts", "200", je.jsonFromArray(result))
		}

		if(method == "getPosts") {
			Post result[] = remoteComponent.getPosts()
			return connection.buildResponseWithData("getPosts", "200", je.jsonFromArray(result))
		}

		if(method == "clearState") {
			remoteComponent.clearState()
			return connection.buildResponse("clearState", "200")
		}

		return connection.buildResponse(method, "404")
	}

}

