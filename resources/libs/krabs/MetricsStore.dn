data RequestMetric {
    int id
    int arrivalTime
    int cacheLookupTime
    int cacheLookupEndTime
    int databaseRequestStartTime
    int databaseRequestEndTime
    int cacheUpdateStartTime
    int cacheUpdateEndTime
    int executionEnd
}

interface MetricsStore {
    int getId()
    void startProcess(store int threadId)
    void hitCache()
    void missCache()
    void tickMetric(store int threadId, char metric[], opt int cacheSize)
    void startCycleMeasurement()
    void finishCycleMeasurement()
}