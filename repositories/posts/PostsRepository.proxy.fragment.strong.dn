uses libs.utils.Constants


component provides repositories.posts.PostsRepository(AdaptEvents), libs.krabs.RemotesHandler requires time.Timer timer, libs.network.rpc.RPCUtil rpcUtil, data.json.JSONEncoder je, libs.adaptation.AddressHandler ah {
	static Address remotes[] = new Address[]()
	
	implementation RemotesHandler {
		void RemotesHandler:setRemotes(store Address newRemotes[]) {
			remotes = newRemotes
		}

		Address[] RemotesHandler:getRemotes() {
			return remotes
		}

	}

	implementation PostsRepository {
		int addressPointer = 0
		Mutex pointerLock = new Mutex()
		
		Metadata[] buildMetaForMethod(char method[]) {
			Metadata metaMethod = new Metadata("method", method)
			return new Metadata[](metaMethod)
		}

		void PostsRepository:addPost(store Post newPost) {
			AddPostParamsFormat params = new AddPostParamsFormat(newPost)
			char requestBody[] = je.jsonFromData(params)
			Request req = new Request(buildMetaForMethod("addPost"), requestBody)
			anycast(req)
		}

		Post PostsRepository:getPostById(store int postId) {
			GetPostByIdParamsFormat params = new GetPostByIdParamsFormat(postId)
			char requestBody[] = je.jsonFromData(params)
			Request req = new Request(buildMetaForMethod("getPostById"), requestBody)
			Response res = anycast(req)
			return je.jsonToData(res.content, typeof(Post))
		}

		Post[] PostsRepository:getPosts(store int page, store int pageSize) {
			GetPostsParamsFormat params = new GetPostsParamsFormat(page, pageSize)
			char requestBody[] = je.jsonFromData(params)
			Request req = new Request(buildMetaForMethod("getPosts"), requestBody)
			Response res = anycast(req)
			return je.jsonToArray(res.content, typeof(Post[]))
		}

		Post[] PostsRepository:getUserFeed(store int userId) {
			GetUserFeedParamsFormat params = new GetUserFeedParamsFormat(userId)
			char requestBody[] = je.jsonFromData(params)
			Request req = new Request(buildMetaForMethod("getUserFeed"), requestBody)
			Response res = anycast(req)
			return je.jsonToArray(res.content, typeof(Post[]))
		}

		Response hashcast(Request r, int hashKey) {
			mutex(pointerLock) {
				int i = hashKey % remotes.arrayLength
				RequestWrapper reqWrapper = new RequestWrapper(remotes[i], r)
				return rpcUtil.make(reqWrapper)
			}

		}

		Response anycast(Request r) {
			mutex(pointerLock) {
				int i = addressPointer++ % remotes.arrayLength
				RequestWrapper reqWrapper = new RequestWrapper(remotes[i], r)
				return rpcUtil.make(reqWrapper)
			}

		}

	}

}

