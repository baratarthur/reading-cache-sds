const char debugMSG[] = "[Server] -"

data CreatePostDTO {
    int userId
    char content[]
}

data LatencyCheckDTO {
    dec latency
}

component provides Server(Destructor) requires net.TCPSocket, net.TCPServerSocket, libs.utils.Logger logger, data.IntUtil iu, composition.Adapt adapter,
composition.RecursiveLoader loader, repositories.posts.PostsRepository, repositories.cache.CacheRepository, libs.network.http.HTTPUtil httpUtil, data.StringUtil su,
data.json.JSONEncoder je, data.json.JSONParser jsonParser, time.Calendar ic, libs.krabs.LatencyStore ls, libs.krabs.RemotesHandler, libs.adaptation.AdaptationLyfecicle,
libs.krabs.MetricsStore ms, time.TimeUnix timeUnix, time.Timer timer {
    CacheRepository cacheRepo
    LoadedComponents repoComponents[] = new LoadedComponents[](
        loader.load("repositories/cache/CacheRepository.o"),
        loader.load("repositories/cache/CacheRepository.proxy.replicate.strong.o"),
        loader.load("repositories/cache/CacheRepository.proxy.replicate.weak.o"),
        loader.load("repositories/cache/CacheRepository.proxy.fragment.strong.o"),
        loader.load("repositories/cache/CacheRepository.proxy.fragment.weak.o")
    )
    String names[] = new String[](
        new String("CacheRepository"),
        new String("CacheRepository with strong replication"), 
        new String("CacheRepository with weak replication"),
        new String("CacheRepository with strong fragmentation"), 
        new String("CacheRepository with weak fragmentation")
    )
    String remoteNames[] = new String[](
        new String("cache-repository"),
        new String("cache-repository-replicate-strong"),
        new String("cache-repository-replicate-weak"),
        new String("cache-repository-fragment-strong"),
        new String("cache-repository-fragment-weak")
    )
    int lastComponentIndex = 0
    bool serviceStatus = false
    bool cacheSaveServiceRunTime = false

        
    void Destructor:destroy() {
        serviceStatus = false
    }
    
    void Server:start(int PORT) {
        TCPServerSocket host = new TCPServerSocket()
		serviceStatus = true

		if (!host.bind(TCPServerSocket.ANY_ADDRESS, PORT)) {
			logger.error("Error: failed to bind master socket")
			return
		}

        initRepo()

		logger.storeInfo("$debugMSG Server started on port $(iu.makeString(PORT))")
		while (serviceStatus) {
			TCPSocket client = new TCPSocket()
			if (client.accept(host)) {
                int tId = ms.getId()
                ms.startProcess(tId)
                asynch::handleRequest(client, tId)
            }
		}
    }

    void initRepo() {
        cacheRepo = new CacheRepository() from repoComponents[lastComponentIndex].mainComponent
    }
    
    void Server:handleRequest(store TCPSocket s, store int threadId) {
        HTTPMessage msg = httpUtil.readHTTPRequest(s)
        HTTPResponse res = null
        res = process(msg, threadId)
        if (res != null) httpUtil.sendResponse(msg, res)
        else httpUtil.sendResponse(msg, httpUtil.build404(msg))
        ms.tickMetric(threadId, "executionEnd")
        s.disconnect()
    }

    HTTPResponse process(HTTPMessage req, store int threadId) {
        HTTPResponse res = null
        DateTime startExecutionTime = ic.getTime()

        if(req.command == "GET") res = processGetRequests(req, threadId)
        else if (req.command == "POST") res = processPostRequests(req, threadId)

        int executionTimeInMs = ls.getMilisecondsExecutionTimeSince(startExecutionTime)
        ls.storeExecutionTime(executionTimeInMs, req)

        return res
    }

    HTTPResponse processGetRequests(HTTPMessage req, store int threadId) {
      
        if (req.resource == "/") return getHello(req)
        else if (req.resource == "/end") return getEnd(req)
        else if (req.resource == "/all") return getAll(req, threadId)
        else if (su.startsWith(req.resource, "/feed/")) return getFeed(req, threadId)
        else if (su.startsWith(req.resource, "/post/")) return getPostById(req, threadId)
        else if (req.resource == "/current-latency") return getCurrentRequestTime(req)

        return null
    }

    HTTPResponse getHello(HTTPMessage req) {
        char responseContent[] = "Hello!"
        logger.storeInfo("[START] ======================\n")
        ms.startCycleMeasurement()
        cacheSaveServiceRunTime = true
        asynch::saveCacheInDatabase()
        return httpUtil.build200(req, responseContent)
    }

    HTTPResponse getEnd(HTTPMessage req) {
        char responseContent[] = "Finish test!"
        logger.storeInfo("[END] =======================\n\n")
        ms.finishCycleMeasurement()
        cacheSaveServiceRunTime = false
        return httpUtil.build200(req, responseContent)
    }

    HTTPResponse getAll(HTTPMessage req, int threadId) {
        // int page = httpUtil.getQueryStringValue(req.queryString, "page").string.intFromString()
        // int pageSize = httpUtil.getQueryStringValue(req.queryString, "pageSize").string.intFromString()
        ms.tickMetric(threadId, "cacheLookupTime")
        Post allPosts[] = cacheRepo.getPosts()
        ms.tickMetric(threadId, "cacheLookupEndTime")
        char responseContent[] = je.jsonFromArray(allPosts)
        return httpUtil.build200(req, responseContent)
    }

    HTTPResponse getFeed(HTTPMessage req, int threadId) {
        PostsRepository repo = new PostsRepository()
        String pathInfo[] = su.explode(req.resource, "/") // expected: ["feed", "<userId:number>"]
        int userId = pathInfo[1].string.intFromString()
        
        Post userPosts[]
        ms.tickMetric(threadId, "cacheLookupTime")
        Post cachedPosts[] = cacheRepo.getCachedPosts()
        ms.tickMetric(threadId, "cacheLookupEndTime")
        
        if(cachedPosts.arrayLength > 4) {
            ms.hitCache()
            ms.tickMetric(threadId, "cacheLookupTime")
            userPosts = cacheRepo.getFeedFromCache()
            ms.tickMetric(threadId, "cacheLookupEndTime")
        } else {
            ms.missCache()
            userPosts = repo.getUserFeed(userId, threadId)
        }

        char responseContent[] = je.jsonFromArray(userPosts)
        return httpUtil.build200(req, responseContent)
    }

    HTTPResponse getPostById(HTTPMessage req, int threadId) {
        PostsRepository repo = new PostsRepository()
        String pathInfo[] = su.explode(req.resource, "/") // expected: ["post", "<postId:number>"]
        int postId = pathInfo[1].string.intFromString()
        
        ms.tickMetric(threadId, "cacheLookupTime")
        Post post = cacheRepo.getPostByIdFromCache(postId) // stateful
        ms.tickMetric(threadId, "cacheLookupEndTime")
        
        if(post != null) {
            ms.hitCache()
            char postStr[] = je.jsonFromData(post)
            logger.info("post $(iu.makeString(postId)) found in cache!")
        }
        
        if(post == null) {
            ms.missCache()
            post = repo.getPostById(postId, threadId) // stateless
            char postStr[] = je.jsonFromData(post)
            logger.info("post $(iu.makeString(postId)) loaded from database!")
            ms.tickMetric(threadId, "cacheUpdateStartTime")
            cacheRepo.addPostInCache(post) // stateful
            ms.tickMetric(threadId, "cacheUpdateEndTime")
        }
        
        char responseContent[] = je.jsonFromData(post)
        return httpUtil.build200(req, responseContent)
    }

    HTTPResponse getCurrentRequestTime(HTTPMessage req) {
        LatencyCheckDTO latencyCheckDTO = new LatencyCheckDTO(ls.getCurrentAverageLatency())

        char responseContent[] = je.jsonFromData(latencyCheckDTO)

        return httpUtil.build200(req, responseContent)
    }


    HTTPResponse processPostRequests(HTTPMessage req, store int threadId) {

        if (req.resource == "/post") return postAddPost(req, threadId)
        else if (su.startsWith(req.resource, "/adapt/")) return postAdapt(req)

        return null
    }

    HTTPResponse postAddPost(HTTPMessage req, int threadId) {
        char body[] = new char[](req.postData)
        CreatePostDTO createPostDTO = je.jsonToData(body, typeof(CreatePostDTO))
        
        Post newPost = new Post(0, createPostDTO.userId, 0, createPostDTO.content, new DateTime())
        ms.tickMetric(threadId, "cacheUpdateStartTime")
        cacheRepo.addPostInCache(newPost)
        ms.tickMetric(threadId, "cacheUpdateEndTime")
        
        return httpUtil.build201(req, "Success")
    }

    HTTPResponse postAdapt(HTTPMessage req) {
        String pathInfo[] = su.explode(req.resource, "/") // expected: ["like", "<proxy:number>"]
        int proxyId = pathInfo[1].string.intFromString()
        char body[] = new char[](req.postData)
        Address newAddress[] = je.jsonToArray(body, typeof(Address[]))
        char proxyNamespace[] = remoteNames[proxyId].string

        logger.storeInfo("$debugMSG Adapted, $proxyNamespace, $(iu.makeString(newAddress.arrayLength))")
        changeRepo(proxyId, newAddress)

        return httpUtil.build200(req, "Repository changed to $proxyNamespace")
    }
    
    void changeRepo(int option, Address remotes[]) {
        logger.storeInfo("Changing repository from $(names[lastComponentIndex].string) to $(names[option].string)")
        if(lastComponentIndex != 0) {
            repoComponents[lastComponentIndex].mainComponent.callInterface(
                cacheRepo,
                "libs.adaptation.AdaptationLyfecicle",
                null,
                AdaptationLyfecicle.[onUpdateLocalState()],
                null
            )
        }

        adapter.adaptObject(
            repoComponents[lastComponentIndex].mainComponent,
            cacheRepo,
            repoComponents[option].mainComponent,
            "repositories.cache.CacheRepository"
        )
        lastComponentIndex = option
        
        if (option != 0) {
            RemotesHandler handler = new RemotesHandler() from repoComponents[option].mainComponent
            handler.setRemotes(remotes)
            repoComponents[option].mainComponent.callInterface(
                cacheRepo,
                "libs.adaptation.AdaptationLyfecicle",
                null,
                AdaptationLyfecicle.[onLoadRemoteState()],
                null
            )
        }
    }

    void saveCacheInDatabase() {
        while(true) {
            PostsRepository repo = new PostsRepository()
            if(!cacheSaveServiceRunTime) break
            Post newPosts[] = cacheRepo.getNewPosts()
            if(newPosts.arrayLength > 0) {
                repo.addPosts(newPosts)
                cacheRepo.removeNewPostsFromCache()
            }
            logger.storeInfo("$(iu.makeString(newPosts.arrayLength)) posts saved sucessfully!")
            timer.sleep(1000)
        }
    }
}