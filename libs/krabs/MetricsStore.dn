
const char TAG[] = "[@MetricsStore] - "

component provides MetricsStore requires libs.utils.Logger logger, data.IntUtil iu, time.Timer timer, data.json.JSONEncoder je,
time.Calendar ic, time.TimeUnix timeUnix {
    static RequestMetric requests[] = new RequestMetric[]()

    static bool measure = false

    static int deliveredThreadId = 0
    Mutex idLock = new Mutex()

    void MetricsStore:startCycleMeasurement() {
        measure = true
        asynch::measureEachSecond()
    }

    void MetricsStore:finishCycleMeasurement() {
        measure = false
    }

    int MetricsStore:getId() {
        mutex(idLock) {
            deliveredThreadId++
        }
        return deliveredThreadId
    }

    void measureEachSecond() {
        while(true) {
            if (!measure) break
            dec waitingTime = avarageWaitingTime()
            dec processingTime = avarageProcessingTime()
            // char log[] = new char[](
            //     TAG,
            //     "{",
            //     "\"avarage_processing_time\": \"$(iu.makeString(processingTime))\",",
            //     "\"avarage_waiting_time\": \"$(iu.makeString(waitingTime))\"",
            //     "}"
            // )
            // char log[] = new char[](
            //     TAG,
            //     je.jsonFromArray(requests)
            // )
            // logger.storeInfo(log)
            timer.sleep(1000)
        }
    }

    dec avarageWaitingTime() {
        int amountOfWaiting = 0
        int validMetrics = 0
        for(int i = 0; i < requests.arrayLength; i++) {
            if(requests[i].arrivalTime !=0 && requests[i].executionStart !=0) {
                amountOfWaiting += (requests[i].executionStart - requests[i].arrivalTime)
                validMetrics++
            }
        }
        if (validMetrics == 0) return 0
        return amountOfWaiting / validMetrics
    }

    dec avarageProcessingTime() {
        int amountIncomingRequests = 0
        int validMetrics = 0
        for(int i = 0; i < requests.arrayLength; i++) {
            if(requests[i].executionEnd !=0 && requests[i].executionStart !=0) {
                amountIncomingRequests += (requests[i].executionEnd - requests[i].executionStart)
                validMetrics++
            }
        }
        if (validMetrics == 0) return 0
        return amountIncomingRequests / validMetrics
    }

    void MetricsStore:startProcess(store int threadId) {
        DateTime currentTime = ic.getTime()
        int currentMillisecs = (timeUnix.toUnixTime(currentTime)*1000) + currentTime.millisecond
        RequestMetric rm = new RequestMetric(id = threadId, arrivalTime = currentMillisecs)
        requests = new RequestMetric[](requests, rm)
    }

    void MetricsStore:tickWaitingTime(store int threadId) {
        DateTime currentTime = ic.getTime()
        int currentMillisecs = (timeUnix.toUnixTime(currentTime)*1000) + currentTime.millisecond
        logger.storeInfo("searching fot threadId: $(iu.makeString(threadId)), in array length: $(iu.makeString(requests.arrayLength))")
        for(int i = 0; i < requests.arrayLength; i++) {
            if (requests[i].id == threadId) {
                logger.storeInfo("request exists")
                requests[i].executionStart = currentMillisecs
                break
            }
        }
    }

    void MetricsStore:tickEndTime(store int threadId) {
        DateTime currentTime = ic.getTime()
        int currentMillisecs = (timeUnix.toUnixTime(currentTime)*1000) + currentTime.millisecond
        for(int i = 0; i < requests.arrayLength; i++) {
            if (requests[i].id == threadId) {
                requests[i].executionEnd = currentMillisecs
                break
            }
        }
    }
}
