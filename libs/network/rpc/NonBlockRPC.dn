uses libs.utils.Constants

component provides libs.network.rpc.NonBlockRPC requires libs.network.rpc.RPCUtil rpcUtil, libs.network.RemotesHandler {
    Response acc[] = new Response[]()

    Response[] NonBlockRPC:nonBlockingBroadcastList(Request r, Pool p[]) {
        Thread threads[] = new Thread[]()
        
        for(int i = 0; i < p.arrayLength; i++) {
            Thread t = asynch::makeNonBlockingRequest(r, p[i], i)
            threads = new Thread[](threads, t)
        }

        for(int i = 0; i < threads.arrayLength; i++) {
            threads[i].join()
        }

        return acc
    }

    void makeNonBlockingRequest(Request r, Pool p, int poolPosition) {
        acc = new Response[](acc, rpcUtil.make(r, p, poolPosition))
    }
}