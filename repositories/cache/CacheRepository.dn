uses libs.utils.Constants
uses libs.utils.DatabaseConfig

const char debugMSG[] = "[@CacheRepository]"

component provides repositories.cache.CacheRepository requires time.TimeUnix timeUnix, time.Calendar ic, data.IntUtil iu,
libs.utils.Logger logger, libs.krabs.LatencyStore ls, data.json.JSONEncoder je, repositories.posts.PostsRepository {
    Mutex cacheLock = new Mutex()

    void CacheRepository:setPosts(store Post posts[]) {
        cache = posts
    }

    Post[] CacheRepository:getPosts() {
        return cache
    }
    
    Post CacheRepository:getPostByIdFromCache(store int postId) {
        DateTime startExecutionTime = ic.getTime()
        for (int i = 0; i < cache.arrayLength; i++) {
            if (cache[i].id == postId) {
                int ttlUnixInSeconds = timeUnix.toUnixTime(cache[i].ttl)
                int nowUnixInSeconds = timeUnix.toUnixTime(ic.getTime())
                if((nowUnixInSeconds - ttlUnixInSeconds) < 5 * 60) {
                    int executionTime = ls.getMilisecondsExecutionTimeSince(startExecutionTime)
                    char logMsg[] = new char[](
                        debugMSG, " ",
                        "post $(iu.makeString(postId)) found in cache: ",
                        iu.makeString(executionTime),
                        " ms"
                    )
                    // logger.storeInfo(logMsg)
                    return cache[i]    
                }
            }
        }

        int executionTime = ls.getMilisecondsExecutionTimeSince(startExecutionTime)
        char logMsg[] = new char[](
            debugMSG, " ",
            "post $(iu.makeString(postId)) not in cache: ",
            iu.makeString(executionTime),
            " ms"
        )
        // logger.storeInfo(logMsg)
        return null
    }

    void CacheRepository:addPostInCache(store Post cachePost) {
        mutex(cacheLock) { cache = new Post[](cache, cachePost) }
    }

    void CacheRepository:clearState() {
        cache = new Post[]()
    }

}