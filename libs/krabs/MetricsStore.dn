
const char TAG[] = "[@MetricsStore] - "

component provides MetricsStore requires libs.utils.Logger logger, data.IntUtil iu, time.Timer timer {
    static int requests
    static int active_requests
    static int completed
    static int total_processing_time

    static bool measure = false

    Mutex rLock = new Mutex()
    Mutex aLock = new Mutex()
    Mutex cLock = new Mutex()
    Mutex tLock = new Mutex()

    void MetricsStore:startCycleMeasurement() {
        measure = true
        asynch::measureEachSecond()
    }

    void MetricsStore:finishCycleMeasurement() {
        measure = false
    }

    void measureEachSecond() {
        while(true) {
            if (!measure) break
            char log[] = new char[](
                TAG,
                "{",
                "\"requests\": \"$(iu.makeString(requests))\",",
                "\"active_requests\": \"$(iu.makeString(active_requests))\",",
                "\"completed\": \"$(iu.makeString(completed))\"",
                "}"
            )
            logger.storeInfo(log)
            timer.sleep(1000)
        }
    }

    void MetricsStore:startProcess() {
        mutex(rLock) {
            mutex(aLock) {
                requests++
                active_requests++
            }
        }
    }

    void MetricsStore:startWaiting() {
        mutex(aLock) {
            active_requests--
        }
    }

    void MetricsStore:finishWaiting() {
        mutex(cLock) {
            completed++
        }
    }

    void MetricsStore:finishProcess() {
        mutex(rLock) {
            mutex(cLock) {
                requests--
                completed--
            }
        }
    }
}
