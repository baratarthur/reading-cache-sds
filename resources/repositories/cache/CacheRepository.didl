{
    "name": "cache-repository",
    "dependencies": [
        { "lib": "time.Timer", "alias": "timer" },
        { "lib": "libs.utils.PostsUtils", "alias": "pu" },
        { "lib": "libs.krabs.LatencyStore", "alias": "ls" },
        { "lib": "data.IntUtil", "alias": "iu" },
        { "lib": "libs.utils.Logger", "alias": "logger" }
    ],
    "attributes": {
        "cache": { "onTransfer": "setPosts", "onLoad": "getPosts" }
    },
    "methods": {
        "getPosts": {
            "returnParser": "je.jsonToArray({}, typeof(Post[]))",
            "remoteReturnParser": "je.jsonFromArray({})",
            "onMerge": "pu.accumulate"
        },
        "storeNewPosts": {
            "global": true
        },
        "removeNewPostsFromCache": {
            "global": true
        },
        "getCachedPosts": {
            "returnParser": "je.jsonToArray({}, typeof(Post[]))",
            "remoteReturnParser": "je.jsonFromArray({})",
            "onMerge": "pu.accumulate"
        },
        "setPosts": {
            "balance": "posts",
            "hashkey": "id"
        },
        "addPostInCache": {
            "hashkey": "cachePost.id"
        },
        "addNewPostInCache": {
            "hashkey": "addressPointer++"
        },
        "getPostByIdFromCache": {
            "returnParser": "je.jsonToData({}, typeof(CachedPost))",
            "remoteReturnParser": "je.jsonFromData({})",
            "hashkey": "postId"
        }
    }
}