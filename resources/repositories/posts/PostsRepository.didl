{
    "name": "post-repository",
    "allows": [" RS ", " RW ", " FS ", " FW "],
    "dependencies": [
        { "lib": "time.Timer", "alias": "timer" }
    ],
    "attributes": {
        "readingCache": { "onTransfer": "setPosts", "onMerge": "accumulate" }
    },
    "methods": {
        "getPosts": {
            "returnParser": "je.jsonToArray({}, typeof(Post[]))",
            "remoteReturnParser": "je.jsonFromArray({})"
        },
        "setPosts": {
            "hashKey": "id"
        },
        "getPostById": {
            "returnParser": "je.jsonToData({}, typeof(Post))",
            "remoteReturnParser": "je.jsonFromArray({})",
            "hashKey": "postId"
        },
        "getUserFeed": {
            "returnParser": "je.jsonToArray({}, typeof(Post[]))",
            "remoteReturnParser": "je.jsonFromArray({})",
            "hashKey": "userId"
        }
    }
}