uses libs.utils.Constants


component provides repositories.cache.CacheRepository(libs.adaptation.AdaptationLyfecicle), libs.network.RemotesHandler requires time.Timer timer, libs.utils.PostsUtils pu, libs.krabs.LatencyStore ls, data.IntUtil iu, libs.utils.Logger logger, libs.network.rpc.RPCUtil rpcUtil, data.json.JSONEncoder je, net.TCPSocket tcpSocket, time.Calendar ic, libs.network.rpc.NonBlockRPC nbrpcLib {
	static Address remotes[] = new Address[]()
	
	implementation RemotesHandler {
		void RemotesHandler:setRemotes(store Address newRemotes[]) {
			remotes = newRemotes
		}

		void RemotesHandler:disconnectAll() {
		}

	}

	implementation CacheRepository {
		int addressPointer = 0
		Mutex pointerLock = new Mutex()
		
		Metadata[] buildMetaForMethod(char method[]) {
			Metadata metaMethod = new Metadata("method", method)
			return new Metadata[](metaMethod)
		}

		void CacheRepository:setPosts(store Post posts[]) {
			int spaceSize = remotes.arrayLength
			for(int i = 0; i < spaceSize; i++) {
				Post subset[] = new Post[]()
				for(int j = 0; j < posts.arrayLength; j++) {
					if(posts[j].id % spaceSize == i) {
						subset = new Post[](subset, posts[j])
					}

				}

				SetPostsParamsFormat params = new SetPostsParamsFormat(subset)
				char requestBody[] = je.jsonFromData(params)
				Request req = new Request(buildMetaForMethod("setPosts"), requestBody)
				hashcast(req, i)
			}

		}

		void CacheRepository:addPostInCache(store Post cachePost) {
			DateTime timeBeforeParamPacking = ic.getTime()
			AddPostInCacheParamsFormat params = new AddPostInCacheParamsFormat(cachePost)
			int timeToProcessParamPacking = ls.getMilisecondsExecutionTimeSince(timeBeforeParamPacking)
			DateTime timeBeforeParsing = ic.getTime()
			char requestBody[] = je.jsonFromData(params)
			int timeToProcessParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParsing)
			DateTime timeBeforeRequestMount = ic.getTime()
			Request req = new Request(buildMetaForMethod("addPostInCache"), requestBody)
			int timeToProcessRequestMount = ls.getMilisecondsExecutionTimeSince(timeBeforeRequestMount)
			DateTime timeBeforeMethodCall = ic.getTime()
			hashcast(req, cachePost.id)
			int timeToProcessMethodCall = ls.getMilisecondsExecutionTimeSince(timeBeforeMethodCall)
			DateTime timeBeforeParseReturn = ic.getTime()
			int timeToProcessReturnParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParseReturn)
			logger.storeInfo("{\"timeToProcessParamPacking\": \"$(iu.makeString(timeToProcessParamPacking))\", \"timeToProcessParsing\": \"$(iu.makeString(timeToProcessParsing))\", \"timeToProcessRequestMount\": \"$(iu.makeString(timeToProcessRequestMount))\", \"timeToProcessMethodCall\": \"$(iu.makeString(timeToProcessMethodCall))\", \"timeToProcessReturnParsing\": \"$(iu.makeString(timeToProcessReturnParsing))\"}")
		}

		void CacheRepository:addNewPostInCache(store Post cachePost) {
			DateTime timeBeforeParamPacking = ic.getTime()
			AddNewPostInCacheParamsFormat params = new AddNewPostInCacheParamsFormat(cachePost)
			int timeToProcessParamPacking = ls.getMilisecondsExecutionTimeSince(timeBeforeParamPacking)
			DateTime timeBeforeParsing = ic.getTime()
			char requestBody[] = je.jsonFromData(params)
			int timeToProcessParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParsing)
			DateTime timeBeforeRequestMount = ic.getTime()
			Request req = new Request(buildMetaForMethod("addNewPostInCache"), requestBody)
			int timeToProcessRequestMount = ls.getMilisecondsExecutionTimeSince(timeBeforeRequestMount)
			DateTime timeBeforeMethodCall = ic.getTime()
			hashcast(req, addressPointer++)
			int timeToProcessMethodCall = ls.getMilisecondsExecutionTimeSince(timeBeforeMethodCall)
			DateTime timeBeforeParseReturn = ic.getTime()
			int timeToProcessReturnParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParseReturn)
			logger.storeInfo("{\"timeToProcessParamPacking\": \"$(iu.makeString(timeToProcessParamPacking))\", \"timeToProcessParsing\": \"$(iu.makeString(timeToProcessParsing))\", \"timeToProcessRequestMount\": \"$(iu.makeString(timeToProcessRequestMount))\", \"timeToProcessMethodCall\": \"$(iu.makeString(timeToProcessMethodCall))\", \"timeToProcessReturnParsing\": \"$(iu.makeString(timeToProcessReturnParsing))\"}")
		}

		void CacheRepository:storeNewPosts() {
			DateTime timeBeforeParamPacking = ic.getTime()
			int timeToProcessParamPacking = ls.getMilisecondsExecutionTimeSince(timeBeforeParamPacking)
			DateTime timeBeforeParsing = ic.getTime()
			char requestBody[] = ""
			int timeToProcessParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParsing)
			DateTime timeBeforeRequestMount = ic.getTime()
			Request req = new Request(buildMetaForMethod("storeNewPosts"), requestBody)
			int timeToProcessRequestMount = ls.getMilisecondsExecutionTimeSince(timeBeforeRequestMount)
			DateTime timeBeforeMethodCall = ic.getTime()
			nonBlockingBroadcastList(req)
			int timeToProcessMethodCall = ls.getMilisecondsExecutionTimeSince(timeBeforeMethodCall)
			DateTime timeBeforeParseReturn = ic.getTime()
			int timeToProcessReturnParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParseReturn)
			logger.storeInfo("{\"timeToProcessParamPacking\": \"$(iu.makeString(timeToProcessParamPacking))\", \"timeToProcessParsing\": \"$(iu.makeString(timeToProcessParsing))\", \"timeToProcessRequestMount\": \"$(iu.makeString(timeToProcessRequestMount))\", \"timeToProcessMethodCall\": \"$(iu.makeString(timeToProcessMethodCall))\", \"timeToProcessReturnParsing\": \"$(iu.makeString(timeToProcessReturnParsing))\"}")
		}

		void CacheRepository:removeNewPostsFromCache() {
			DateTime timeBeforeParamPacking = ic.getTime()
			int timeToProcessParamPacking = ls.getMilisecondsExecutionTimeSince(timeBeforeParamPacking)
			DateTime timeBeforeParsing = ic.getTime()
			char requestBody[] = ""
			int timeToProcessParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParsing)
			DateTime timeBeforeRequestMount = ic.getTime()
			Request req = new Request(buildMetaForMethod("removeNewPostsFromCache"), requestBody)
			int timeToProcessRequestMount = ls.getMilisecondsExecutionTimeSince(timeBeforeRequestMount)
			DateTime timeBeforeMethodCall = ic.getTime()
			nonBlockingBroadcastList(req)
			int timeToProcessMethodCall = ls.getMilisecondsExecutionTimeSince(timeBeforeMethodCall)
			DateTime timeBeforeParseReturn = ic.getTime()
			int timeToProcessReturnParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParseReturn)
			logger.storeInfo("{\"timeToProcessParamPacking\": \"$(iu.makeString(timeToProcessParamPacking))\", \"timeToProcessParsing\": \"$(iu.makeString(timeToProcessParsing))\", \"timeToProcessRequestMount\": \"$(iu.makeString(timeToProcessRequestMount))\", \"timeToProcessMethodCall\": \"$(iu.makeString(timeToProcessMethodCall))\", \"timeToProcessReturnParsing\": \"$(iu.makeString(timeToProcessReturnParsing))\"}")
		}

		CachedPost CacheRepository:getPostByIdFromCache(store int postId) {
			DateTime timeBeforeParamPacking = ic.getTime()
			GetPostByIdFromCacheParamsFormat params = new GetPostByIdFromCacheParamsFormat(postId)
			int timeToProcessParamPacking = ls.getMilisecondsExecutionTimeSince(timeBeforeParamPacking)
			DateTime timeBeforeParsing = ic.getTime()
			char requestBody[] = je.jsonFromData(params)
			int timeToProcessParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParsing)
			DateTime timeBeforeRequestMount = ic.getTime()
			Request req = new Request(buildMetaForMethod("getPostByIdFromCache"), requestBody)
			int timeToProcessRequestMount = ls.getMilisecondsExecutionTimeSince(timeBeforeRequestMount)
			DateTime timeBeforeMethodCall = ic.getTime()
			Response res = hashcast(req, postId)
			int timeToProcessMethodCall = ls.getMilisecondsExecutionTimeSince(timeBeforeMethodCall)
			if (res.content == "{}") return null
			DateTime timeBeforeParseReturn = ic.getTime()
			CachedPost response = je.jsonToData(res.content, typeof(CachedPost))
			int timeToProcessReturnParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParseReturn)
			logger.storeInfo("{\"timeToProcessParamPacking\": \"$(iu.makeString(timeToProcessParamPacking))\", \"timeToProcessParsing\": \"$(iu.makeString(timeToProcessParsing))\", \"timeToProcessRequestMount\": \"$(iu.makeString(timeToProcessRequestMount))\", \"timeToProcessMethodCall\": \"$(iu.makeString(timeToProcessMethodCall))\", \"timeToProcessReturnParsing\": \"$(iu.makeString(timeToProcessReturnParsing))\"}")
			return response
		}

		Post[] CacheRepository:getCachedPosts() {
			DateTime timeBeforeParamsPack = ic.getTime()
			int timeToProcessParamsPack = ls.getMilisecondsExecutionTimeSince(timeBeforeParamsPack)
			char requestBody[] = ""
			DateTime timeBeforeRequestMount = ic.getTime()
			Request req = new Request(buildMetaForMethod("getCachedPosts"), requestBody)
			int timeToProcessRequestMount = ls.getMilisecondsExecutionTimeSince(timeBeforeRequestMount)
			DateTime timeBeforeRPC = ic.getTime()
			Response res[] = nonBlockingBroadcastList(req)
			int timeToProcessRPC = ls.getMilisecondsExecutionTimeSince(timeBeforeRPC)
			DateTime timeBeforeCombine = ic.getTime()
			Post returnValue[]
			for(int i = 0; i < res.arrayLength; i++) {
				Post partialValue[] = je.jsonToArray(res[i].content, typeof(Post[]))
				returnValue = pu.accumulate(returnValue, partialValue)
			}

			int timeToProcessCombine = ls.getMilisecondsExecutionTimeSince(timeBeforeCombine)
			logger.storeInfo("{\"timeToProcessParamsPack\": \"$(iu.makeString(timeToProcessParamsPack))\", \"timeToProcessRequestMount\": \"$(iu.makeString(timeToProcessRequestMount))\", \"timeToProcessRPC\": \"$(iu.makeString(timeToProcessRPC))\", \"timeToProcessCombine\": \"$(iu.makeString(timeToProcessCombine))\"}")
			return returnValue
		}

		Post[] CacheRepository:getPosts() {
			DateTime timeBeforeParamsPack = ic.getTime()
			int timeToProcessParamsPack = ls.getMilisecondsExecutionTimeSince(timeBeforeParamsPack)
			char requestBody[] = ""
			DateTime timeBeforeRequestMount = ic.getTime()
			Request req = new Request(buildMetaForMethod("getPosts"), requestBody)
			int timeToProcessRequestMount = ls.getMilisecondsExecutionTimeSince(timeBeforeRequestMount)
			DateTime timeBeforeRPC = ic.getTime()
			Response res[] = nonBlockingBroadcastList(req)
			int timeToProcessRPC = ls.getMilisecondsExecutionTimeSince(timeBeforeRPC)
			DateTime timeBeforeCombine = ic.getTime()
			Post returnValue[]
			for(int i = 0; i < res.arrayLength; i++) {
				Post partialValue[] = je.jsonToArray(res[i].content, typeof(Post[]))
				returnValue = pu.accumulate(returnValue, partialValue)
			}

			int timeToProcessCombine = ls.getMilisecondsExecutionTimeSince(timeBeforeCombine)
			logger.storeInfo("{\"timeToProcessParamsPack\": \"$(iu.makeString(timeToProcessParamsPack))\", \"timeToProcessRequestMount\": \"$(iu.makeString(timeToProcessRequestMount))\", \"timeToProcessRPC\": \"$(iu.makeString(timeToProcessRPC))\", \"timeToProcessCombine\": \"$(iu.makeString(timeToProcessCombine))\"}")
			return returnValue
		}

		void CacheRepository:clearState() {
			DateTime timeBeforeParamPacking = ic.getTime()
			int timeToProcessParamPacking = ls.getMilisecondsExecutionTimeSince(timeBeforeParamPacking)
			DateTime timeBeforeParsing = ic.getTime()
			char requestBody[] = ""
			int timeToProcessParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParsing)
			DateTime timeBeforeRequestMount = ic.getTime()
			Request req = new Request(buildMetaForMethod("clearState"), requestBody)
			int timeToProcessRequestMount = ls.getMilisecondsExecutionTimeSince(timeBeforeRequestMount)
			DateTime timeBeforeMethodCall = ic.getTime()
			nonBlockingBroadcastList(req)
			int timeToProcessMethodCall = ls.getMilisecondsExecutionTimeSince(timeBeforeMethodCall)
			DateTime timeBeforeParseReturn = ic.getTime()
			int timeToProcessReturnParsing = ls.getMilisecondsExecutionTimeSince(timeBeforeParseReturn)
			logger.storeInfo("{\"timeToProcessParamPacking\": \"$(iu.makeString(timeToProcessParamPacking))\", \"timeToProcessParsing\": \"$(iu.makeString(timeToProcessParsing))\", \"timeToProcessRequestMount\": \"$(iu.makeString(timeToProcessRequestMount))\", \"timeToProcessMethodCall\": \"$(iu.makeString(timeToProcessMethodCall))\", \"timeToProcessReturnParsing\": \"$(iu.makeString(timeToProcessReturnParsing))\"}")
		}

		Response anycast(Request r) {
			int i = 0
			mutex(pointerLock){ i = addressPointer++ % remotes.arrayLength }
			ReqWrapper w = new ReqWrapper(r, remotes[i], i)
			return rpcUtil.make(w)
		}

		Response[] nonBlockingBroadcastList(Request r) {
			NonBlockRPC nbrpc = new NonBlockRPC()
			return nbrpc.nonBlockingBroadcastList(r, remotes)
		}

		Response hashcast(Request r, int hashKey) {
			int i = 0
			i = hashKey % remotes.arrayLength
			ReqWrapper w = new ReqWrapper(r, remotes[i], i)
			return rpcUtil.make(w)
		}

		bool AdaptationLyfecicle:onLoadRemoteState() {
			setPosts(cache)
			return true
		}

		bool AdaptationLyfecicle:onUpdateLocalState() {
			cache = getPosts()
			return true
		}

	}

}

