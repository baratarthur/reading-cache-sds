uses libs.utils.Constants


component provides repositories.cache.CacheRepository(libs.adaptation.AdaptationLyfecicle), libs.network.RemotesHandler requires time.Timer timer, libs.utils.PostsUtils pu, libs.krabs.LatencyStore ls, data.IntUtil iu, libs.utils.Logger logger, libs.network.rpc.RPCUtil rpcUtil, data.json.JSONEncoder je, net.TCPSocket tcpSocket, libs.network.rpc.NonBlockRPC nbrpcLib {
	static Pool connectionPool[] = new Pool[]()
	
	implementation RemotesHandler {
		const int POOL_SIZE = 6
		
		void RemotesHandler:setRemotes(store Address newRemotes[]) {
			for(int i = 0; i < newRemotes.arrayLength; i++) {
				TCPSocket remoteSockets[] = new TCPSocket[]()
				Mutex remoteLocks[] = new Mutex[]()
				for(int j = 0; j < POOL_SIZE; j++) {
					TCPSocket s = new TCPSocket()
					Mutex lock = new Mutex()
					if(!s.connect(newRemotes[i].name, newRemotes[i].port)) {
						logger.error("Error: failed to connect to remote $(newRemotes[i].name):$(iu.makeString(newRemotes[i].port))")
						return
					}

					remoteSockets = new TCPSocket[](remoteSockets, s)
					remoteLocks = new Mutex[](remoteLocks, lock)
				}

				Pool p = new Pool(remoteSockets, remoteLocks, 0)
				connectionPool = new Pool[](connectionPool, p)
			}

		}

		void RemotesHandler:disconnectAll() {
			for(int i = 0; i < connectionPool.arrayLength; i++) {
				for(int j = 0; j < connectionPool[i].sockets.arrayLength; j++) {
					mutex(connectionPool[i].locks[j]) {
						connectionPool[i].sockets[j].disconnect()
					}

				}

			}

		}

	}

	implementation CacheRepository {
		int addressPointer = 0
		Mutex pointerLock = new Mutex()
		
		Metadata[] buildMetaForMethod(char method[]) {
			Metadata metaMethod = new Metadata("method", method)
			return new Metadata[](metaMethod)
		}

		void CacheRepository:setPosts(store Post posts[]) {
			SetPostsParamsFormat params = new SetPostsParamsFormat(posts)
			char requestBody[] = je.jsonFromData(params)
			Request req = new Request(buildMetaForMethod("setPosts"), requestBody)
			broadcast(req)
			
		}

		void CacheRepository:addPostInCache(store Post cachePost) {
			AddPostInCacheParamsFormat params = new AddPostInCacheParamsFormat(cachePost)
			char requestBody[] = je.jsonFromData(params)
			Request req = new Request(buildMetaForMethod("addPostInCache"), requestBody)
			anycast(req)
			
		}

		void CacheRepository:addNewPostInCache(store Post cachePost) {
			AddNewPostInCacheParamsFormat params = new AddNewPostInCacheParamsFormat(cachePost)
			char requestBody[] = je.jsonFromData(params)
			Request req = new Request(buildMetaForMethod("addNewPostInCache"), requestBody)
			broadcast(req)
			
		}

		void CacheRepository:storeNewPosts() {
			char requestBody[] = ""
			Request req = new Request(buildMetaForMethod("storeNewPosts"), requestBody)
			anycast(req)
			
		}

		void CacheRepository:removeNewPostsFromCache() {
			char requestBody[] = ""
			Request req = new Request(buildMetaForMethod("removeNewPostsFromCache"), requestBody)
			anycast(req)
			
		}

		CachedPost CacheRepository:getPostByIdFromCache(store int postId) {
			GetPostByIdFromCacheParamsFormat params = new GetPostByIdFromCacheParamsFormat(postId)
			char requestBody[] = je.jsonFromData(params)
			Request req = new Request(buildMetaForMethod("getPostByIdFromCache"), requestBody)
			Response res = anycast(req)
			if (res.content == "{}") return null
			return je.jsonToData(res.content, typeof(CachedPost))
		}

		Post[] CacheRepository:getCachedPosts() {
			char requestBody[] = ""
			Request req = new Request(buildMetaForMethod("getCachedPosts"), requestBody)
			Response res = anycast(req)
			if (res.content == "{}") return null
			return je.jsonToArray(res.content, typeof(Post[]))
		}

		Post[] CacheRepository:getPosts() {
			char requestBody[] = ""
			Request req = new Request(buildMetaForMethod("getPosts"), requestBody)
			Response res = anycast(req)
			if (res.content == "{}") return null
			return je.jsonToArray(res.content, typeof(Post[]))
		}

		void CacheRepository:clearState() {
			char requestBody[] = ""
			Request req = new Request(buildMetaForMethod("clearState"), requestBody)
			nonBlockingBroadcastList(req)
			
		}

		Response anycast(Request r) {
			int i = 0
			mutex(pointerLock){ i = addressPointer++ % connectionPool[i].arrayLength }
			return rpcUtil.make(r, connectionPool[i])
		}

		Response[] nonBlockingBroadcastList(Request r) {
			NonBlockRPC nbrpc = new NonBlockRPC()
			return nbrpc.nonBlockingBroadcastList(r, connectionPool)
		}

		Response broadcast(Request r) {
			Response res = nonBlockingBroadcastList(r)[0]
			return res
		}

		bool AdaptationLyfecicle:onLoadRemoteState() {
			setPosts(cache)
			return true
		}

		bool AdaptationLyfecicle:onUpdateLocalState() {
			cache = getPosts()
			return true
		}

	}

}

